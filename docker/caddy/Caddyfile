# TLS in front of the local PDS, with certificates from Caddy's own local CA. `make atproto-ca` copies
# the root certificate out of the caddy volume to data/caddy-root.crt, for ATPROTO_CA_FILE.
#
# The .test wildcard covers the accounts' handles (alice.test), which are verified over https: the PDS
# serves their well-known documents, and the app dials .test hosts on loopback in local mode.
pds.localhost, *.test {
	tls internal
	reverse_proxy pds:3000
}
