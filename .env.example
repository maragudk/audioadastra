APP_NAME=app
# In localhost mode (a BASE_URL on localhost or 127.0.0.1) the OAuth callback is on 127.0.0.1, as the
# spec requires, so browse the app at 127.0.0.1 to keep the session cookie on the same host.
BASE_URL=http://127.0.0.1:8080
CSP_ALLOW_UNSAFE_EVAL=false
CSP_ALLOW_UNSAFE_INLINE=true
DATABASE_PATH=app.db
JOB_QUEUE_TIMEOUT=10s
LOG_JSON=false
LOG_LEVEL=debug
LOG_NO_TIME=true
MARKETING_EMAIL_ADDRESS=marketing@example.com
MARKETING_EMAIL_NAME=Marketing
OTEL_EXPORTER_OTLP_HEADERS=x-honeycomb-team=123
POSTMARK_KEY=123
REPLY_TO_EMAIL_ADDRESS=support@example.com
REPLY_TO_EMAIL_NAME=app
SECURE_COOKIE=false
SERVER_ADDRESS=:8080
TRANSACTIONAL_EMAIL_ADDRESS=support@example.com
TRANSACTIONAL_EMAIL_NAME=app

# atproto OAuth. Outside localhost mode the app is a confidential client and refuses to start without
# a P-256 private key in multibase encoding and an ID for it. Generate a key with:
#   goat key generate -t P-256 --terse
OAUTH_PRIVATE_KEY=
OAUTH_KEY_ID=

# Local atproto network from docker-compose.yml (see README). Leave empty to use the real network.
ATPROTO_PLC_URL=
ATPROTO_CA_FILE=
ATPROTO_LOCAL_HANDLE_SUFFIX=
